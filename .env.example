# ==============================================================================
# Environment Configuration Template for AI Code Review Platform
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="CodeReviewAI"
APP_VERSION="0.1.0"
APP_SECRET_KEY=change-me-to-a-secure-32-byte-hex-string-for-jwt-signing
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=code_reviewer
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_reviewer
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=default

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_NAME=

# LLM Providers Configuration
# Supported providers: openai, anthropic, gemini, mock
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Security & Sandboxing
ENCRYPTION_KEY=32-character-base64-encryption-key-for-tokens
ANALYZER_TIMEOUT_SECONDS=60
MAX_DIFF_FILES=50
MAX_DIFF_SIZE_BYTES=1048576

# Observability & Metrics
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
